[
  {"name": "note", "order": 1, "title": "Note", "description": "Markdown notes", "main": "notes.md",
   "starters": {"notes.md": "# {title}\n\n"}},
  {"name": "page", "order": 2, "title": "Web page", "description": "one self-contained HTML page", "main": "index.html", "open": "index.html",
   "starters": {"index.html": "<!doctype html>\n<html><head><meta charset='utf-8'><title>{title}</title></head><body>\n</body></html>\n"}},
  {"name": "site", "order": 3, "title": "Website", "description": "index.html plus other files", "main": "index.html", "open": "index.html",
   "starters": {"index.html": "<!doctype html>\n<html><head><meta charset='utf-8'><title>{title}</title></head><body>\n</body></html>\n"}},
  {"name": "code", "order": 4, "title": "Code (any files)", "description": "any files, nothing to run", "main": "README.md",
   "starters": {"README.md": "# {title}\n"}},
  {"name": "data", "order": 5, "title": "Data", "description": "csv / json files", "main": "data.csv", "starters": {"data.csv": ""}},

  {"name": "python", "order": 10, "title": "Python", "description": "Python script or project; test runs pytest", "main": "main.py",
   "starters": {"main.py": "print('hello from {name}')\n"},
   "detect": ["python", "--version"], "detect_sandbox": ["python3", "--version"],
   "commands": [["run", "python {main}"], ["test", "python -m pytest -q"]],
   "sandbox_commands": [["run", "python3 {main}"], ["test", "python3 -m pytest -q"]],
   "install": "winget install -e --id Python.Python.3.12"},
  {"name": "node", "order": 11, "title": "Node.js", "description": "JavaScript with Node; build runs npm install", "main": "index.js",
   "starters": {"index.js": "console.log('hello from {name}');\n",
                "package.json": "{\n  \"name\": \"{name}\",\n  \"version\": \"1.0.0\",\n  \"private\": true,\n  \"scripts\": {\"start\": \"node index.js\", \"test\": \"node --test\"}\n}\n"},
   "detect": ["node", "--version"],
   "commands": [["build", "npm install --no-fund --no-audit"], ["run", "node {main}"], ["test", "npm test --silent"]],
   "install": "winget install -e --id OpenJS.NodeJS.LTS"},
  {"name": "rust", "order": 12, "title": "Rust", "description": "a Cargo crate", "main": "src/main.rs",
   "starters": {"src/main.rs": "fn main() {\n    println!(\"hello from {name}\");\n}\n",
                "Cargo.toml": "[package]\nname = \"{crate}\"\nversion = \"0.1.0\"\nedition = \"2021\"\n\n[dependencies]\n"},
   "detect": ["cargo", "--version"],
   "commands": [["build", "cargo build --color never"], ["run", "cargo run -q --color never"], ["test", "cargo test -q --color never"]],
   "install": "winget install -e --id Rustlang.Rustup", "timeout_s": 600},
  {"name": "go", "order": 13, "title": "Go", "description": "a Go module", "main": "main.go",
   "starters": {"main.go": "package main\n\nimport \"fmt\"\n\nfunc main() {\n\tfmt.Println(\"hello from {name}\")\n}\n",
                "go.mod": "module {crate}\n\ngo 1.21\n"},
   "detect": ["go", "version"],
   "commands": [["build", "go build -o app.exe ."], ["run", "go run ."], ["test", "go test ./..."]],
   "sandbox_commands": [["build", "go build -o app ."], ["run", "go run ."], ["test", "go test ./..."]],
   "install": "winget install -e --id GoLang.Go", "timeout_s": 600},
  {"name": "java", "order": 14, "title": "Java", "description": "Java source (Main.java runs directly)", "main": "Main.java",
   "starters": {"Main.java": "public class Main {\n    public static void main(String[] args) {\n        System.out.println(\"hello from {name}\");\n    }\n}\n"},
   "detect": ["java", "--version"],
   "commands": [["build", "javac -d out {files:.java}"], ["run", "java {main}"]],
   "install": "winget install -e --id EclipseAdoptium.Temurin.21.JDK"},
  {"name": "csharp", "order": 15, "title": "C# (.NET)", "description": "a .NET console project", "main": "Program.cs",
   "starters": {"Program.cs": "Console.WriteLine(\"hello from {name}\");\n",
                "app.csproj": "<Project Sdk=\"Microsoft.NET.Sdk\">\n  <PropertyGroup>\n    <OutputType>Exe</OutputType>\n    <TargetFramework>net8.0</TargetFramework>\n    <ImplicitUsings>enable</ImplicitUsings>\n    <Nullable>enable</Nullable>\n  </PropertyGroup>\n</Project>\n"},
   "detect": ["dotnet", "--version"],
   "commands": [["build", "dotnet build -nologo -v q"], ["run", "dotnet run"], ["test", "dotnet test -nologo"]],
   "install": "winget install -e --id Microsoft.DotNet.SDK.8", "timeout_s": 600},
  {"name": "c", "order": 16, "title": "C", "description": "C compiled with gcc", "main": "main.c",
   "starters": {"main.c": "#include <stdio.h>\n\nint main(void) {\n    printf(\"hello from {name}\\n\");\n    return 0;\n}\n"},
   "detect": ["gcc", "--version"],
   "commands": [["build", "gcc -O2 -Wall -o app.exe {files:.c} -lm"], ["run", "gcc -O2 -Wall -o app.exe {files:.c} -lm && app.exe"]],
   "sandbox_commands": [["build", "gcc -O2 -Wall -o app {files:.c} -lm"], ["run", "gcc -O2 -Wall -o app {files:.c} -lm && ./app"]],
   "install": "winget install -e --id BrechtSanders.WinLibs.POSIX.UCRT"},
  {"name": "cpp", "order": 17, "title": "C++", "description": "C++ compiled with g++", "main": "main.cpp",
   "starters": {"main.cpp": "#include <iostream>\n\nint main() {\n    std::cout << \"hello from {name}\\n\";\n}\n"},
   "detect": ["g++", "--version"],
   "commands": [["build", "g++ -O2 -Wall -std=c++20 -o app.exe {files:.cpp}"], ["run", "g++ -O2 -Wall -std=c++20 -o app.exe {files:.cpp} && app.exe"]],
   "sandbox_commands": [["build", "g++ -O2 -Wall -std=c++20 -o app {files:.cpp}"], ["run", "g++ -O2 -Wall -std=c++20 -o app {files:.cpp} && ./app"]],
   "install": "winget install -e --id BrechtSanders.WinLibs.POSIX.UCRT"},
  {"name": "cuda", "order": 18, "title": "CUDA", "description": "CUDA kernels compiled with nvcc (needs the Visual Studio C++ tools); runs on this PC's GPU, never in the sandbox", "main": "main.cu",
   "starters": {"main.cu": "#include <cstdio>\n\n__global__ void hello() { printf(\"hello from thread %d\\n\", threadIdx.x); }\n\nint main() {\n    hello<<<1, 4>>>();\n    cudaDeviceSynchronize();\n    return 0;\n}\n"},
   "detect": ["nvcc", "--version"], "windows_only": true,
   "commands": [["build", "call \"%VCVARS64%\" >nul && nvcc -O2 -o app.exe {main}"], ["run", "call \"%VCVARS64%\" >nul && nvcc -O2 -o app.exe {main} && app.exe"]],
   "install": "winget install -e --id Nvidia.CUDA (and Visual Studio Build Tools with C++)", "timeout_s": 600},
  {"name": "shell", "order": 19, "title": "Linux shell", "description": "a bash script, run in the Linux sandbox", "main": "run.sh",
   "starters": {"run.sh": "#!/bin/bash\necho \"hello from {name} on $(uname -sr)\"\n"},
   "detect_sandbox": ["bash", "--version"], "linux_only": true,
   "sandbox_commands": [["run", "bash {main}"]]},
  {"name": "latex", "order": 20, "title": "LaTeX document", "description": "LaTeX built to a PDF with pdflatex", "main": "main.tex", "open": "main.pdf",
   "starters": {"main.tex": "\\documentclass{article}\n\\begin{document}\n\\section*{{title}}\nHello.\n\\end{document}\n"},
   "detect": ["pdflatex", "--version"],
   "commands": [["build", "pdflatex -interaction=nonstopmode -halt-on-error {main}"]],
   "install": "winget install -e --id MiKTeX.MiKTeX"},
  {"name": "mermaid", "order": 21, "title": "Mermaid diagram", "description": "a Mermaid diagram rendered to SVG", "main": "diagram.mmd", "open": "diagram.svg",
   "starters": {"diagram.mmd": "flowchart LR\n  A[Start] --> B[Done]\n"},
   "detect": ["mmdc", "--version"],
   "commands": [["build", "mmdc -i {main} -o diagram.svg"]],
   "install": "npm install -g @mermaid-js/mermaid-cli"},
  {"name": "graphviz", "order": 22, "title": "Graphviz graph", "description": "a DOT graph rendered to SVG", "main": "graph.dot", "open": "graph.svg",
   "starters": {"graph.dot": "digraph G {\n  start -> done;\n}\n"},
   "detect": ["dot", "-V"],
   "commands": [["build", "dot -Tsvg {main} -o graph.svg"]],
   "install": "winget install -e --id Graphviz.Graphviz"},
  {"name": "document", "order": 23, "title": "Document (Markdown to Word)", "description": "Markdown converted to a .docx with pandoc", "main": "document.md", "open": "document.docx",
   "starters": {"document.md": "# {title}\n\n"},
   "detect": ["pandoc", "--version"],
   "commands": [["build", "pandoc {main} -o document.docx"]],
   "install": "winget install -e --id JohnMacFarlane.Pandoc"}
]
